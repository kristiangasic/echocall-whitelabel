# Copy to .env for local development. Hosted deployments set these variables directly.

# development | test | production
NODE_ENV=development
PORT=3000

# Public URL of the portal (used for links in e-mails and for secure-cookie detection).
APP_URL=http://localhost:3000

# At least 32 random characters. Signs session cookies and encrypts stored secrets.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# PostgreSQL (reference) or MariaDB/MySQL. Examples:
#   postgres://light:secret@127.0.0.1:5432/echocall_light
#   mariadb://light:secret@127.0.0.1:3306/echocall_light
DATABASE_URL=
# disable | require | no-verify
DATABASE_SSL=disable

# Force secure cookies on or off. Defaults to true when APP_URL starts with https.
# COOKIE_SECURE=true
# Number of trusted reverse proxies in front of the app.
TRUST_PROXY=1

# Your EchoCall API key (requires an active EchoCall subscription).
ECHOCALL_API_KEY=
# ECHOCALL_API_URL=https://hub.echocall.de/api/v1

# Outgoing mail (invitations, password resets). Leave SMTP_HOST empty to disable mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Serve the Angular build from this directory (set in production, e.g. ../web/dist/web/browser).
# WEB_DIST_DIR=
