{
  "name": "@echocall/whitelabel-api",
  "version": "0.2.0",
  "description": "Back end for the EchoCall White Label Portal portal: sessions, settings and the hub API bridge",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "sign-in-link": "node dist/cli/sign-in-link.js",
    "lint": "oxlint --type-aware src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@echocall/whitelabel-api-client": "0.2.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/throttler": "^6.6.0",
    "compression": "1.8.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "kysely": "^0.29.6",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "qrcode-svg": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode-svg": "^1.1.5",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "5.0.1",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "5.0.1"
  }
}
