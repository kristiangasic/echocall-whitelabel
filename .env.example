# Copy this file to .env and fill in your values. Every setting is read once at startup.

# Public URL under which people reach the portal; used for links in mails and for secure-cookie detection.
APP_URL=https://portal.example.com

# Random secret of at least 32 characters; encrypts the stored SMTP password and the second-factor secrets.
# Generate with: openssl rand -hex 32. Keep it: a new one makes both unreadable.
APP_SECRET=

# Connection URL of your own database; PostgreSQL, MySQL and MariaDB are supported.
DATABASE_URL=postgres://whitelabel:CHANGE_ME@localhost:5432/echocall_whitelabel
# MariaDB/MySQL example: DATABASE_URL=mariadb://whitelabel:CHANGE_ME@db.example.com:3306/echocall_whitelabel

# TLS towards the database: disable (default), require, or no-verify for servers with self-signed certificates.
# DATABASE_SSL=disable

# The EchoCall API key of your reseller account; every feature of this portal runs through it.
ECHOCALL_API_KEY=

# Base URL of the EchoCall public API; only change this if EchoCall support tells you to.
# ECHOCALL_API_URL=https://hub.echocall.de/api/v1

# Origin the chat widget files are fetched from and re-served under /embed on your domain.
# ECHOCALL_WIDGET_URL=https://cdn.echocall.de

# Port the HTTP server listens on.
# PORT=3000

# How many reverse proxies sit in front of the app (for correct client IPs in the audit log).
# TRUST_PROXY=1

# Force the Secure flag on session cookies; defaults to on when APP_URL uses https.
# COOKIE_SECURE=true

# Absolute path to the built Angular app; when set, the API serves the web UI itself.
# The Docker image sets this for you.
# WEB_DIST_DIR=/app/apps/web/dist/web/browser

# SMTP server for invite and password reset mails; without it the portal shows one-time links instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=portal@example.com
# SMTP_PASS=
# SMTP_FROM=portal@example.com

# Only used by compose.yaml: password of the bundled PostgreSQL database.
DB_PASSWORD=

# Only used by compose.yaml: the port the portal is published on, on the host.
# Change it when 3000 is already taken; the container keeps its own port.
# HTTP_PORT=3000

# Only used by compose.yaml: user and name of the bundled PostgreSQL database.
# An install from before 0.2.0 keeps its data under the old names: DB_USER=light,
# DB_NAME=echocall_light and COMPOSE_PROJECT_NAME=echocall-light (docs/self-hosting.md, Updates).
# DB_USER=whitelabel
# DB_NAME=echocall_whitelabel
# COMPOSE_PROJECT_NAME=echocall-whitelabel
